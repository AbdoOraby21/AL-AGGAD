# Public Supabase config only — NEVER put service_role or payment secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Business WhatsApp in international digits without '+', e.g. 2010XXXXXXXX
VITE_WHATSAPP_NUMBER=201000000000
# Demo mode for client showcases: 'true' enables the safe mock demo
# (sample data, local-only records, no Supabase writes, no payments,
# no real WhatsApp). Anything else (or missing) means production behavior.
VITE_DEMO_MODE=false
